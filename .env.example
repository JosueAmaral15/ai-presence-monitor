# AI Presence Monitor - modelo de configuracao local.
#
# Nunca coloque credenciais reais neste arquivo de exemplo.
#
# Instalacao recomendada, com acesso restrito ao seu usuario:
#
#   mkdir -p ~/.config/ai-presence-monitor
#   install -m 600 .env.example ~/.config/ai-presence-monitor/.env
#
# Alternativamente, para usar um `.env` apenas neste projeto:
#
#   cp .env.example .env
#   chmod 600 .env
#
# O `.env` contem webhooks/tokens e esta no `.gitignore`.

# Banco local do monitor.
# Caminhos relativos sao resolvidos a partir do diretorio deste .env.
PRESENCE_DB_PATH=./data/presence.db

# Protocolo padrao quando --protocol nao for informado.
# Valores aceitos: protocol1 ou protocol2.
# Recomendado para Codex: protocol2.
PRESENCE_DEFAULT_PROTOCOL=protocol2

# Nome exibido nos alertas. Se vazio, usa o hostname do sistema.
# Exemplo: notebook-josue
PRESENCE_COMPUTER_NAME=

# Intervalo, em segundos, entre checagens do monitor.
# Este valor nao muda os limites dos protocolos; ele so define a frequencia da checagem.
PRESENCE_MONITOR_INTERVAL_SECONDS=30

# Janela de expediente.
# Quando ativada, o monitor so cobra alertas dentro do horario configurado.
# O exemplo abaixo cobre 13:00 ate 18:00 no horario de Sao Paulo.
PRESENCE_WORK_WINDOW_ENABLED=false
PRESENCE_WORK_WINDOW_START=13:00
PRESENCE_WORK_WINDOW_END=18:00
PRESENCE_WORK_WINDOW_TIMEZONE=America/Sao_Paulo

# Com suppress_alerts, alertas novos sao ignorados fora do expediente.
# Com allow_alerts, alertas continuam sendo enviados mesmo fora do expediente.
PRESENCE_OUTSIDE_WORK_WINDOW_BEHAVIOR=suppress_alerts

# Repeticao de alertas dentro do expediente.
# Se ativado, repete amarelo/laranja depois do intervalo configurado enquanto
# o worker continuar atrasado e ativo. Vermelho e sempre unico por episodio.
# Para cobranca continua durante o expediente, altere este campo para true.
PRESENCE_ALERT_REPEAT_ENABLED=false
PRESENCE_ALERT_REPEAT_SECONDS=300
PRESENCE_ALERT_REPEAT_LEVELS=yellow,orange

# Discord - canal de ponto.
# Recebe start, heartbeat, finish e touch quando usado com --notify.
# Cada webhook pertence a um canal especifico.
DISCORD_POINT_WEBHOOK_URL=

# Discord - canal de alertas.
# Recebe alertas amarelo, laranja e vermelho, salvo se houver canal vermelho dedicado.
DISCORD_ALERT_WEBHOOK_URL=

# Discord - opcional, canal exclusivo para alertas vermelhos.
DISCORD_RED_WEBHOOK_URL=

# Telegram - opcional.
# Preencha os dois campos para ativar Telegram.
# Se apenas um deles estiver preenchido, o Telegram continuara desativado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alerta vermelho.
# Valores aceitos:
# - none: apenas envia Discord/Telegram.
# - alarm: executa RED_ALERT_COMMAND.
# - phone: chama PHONE_WEBHOOK_URL.
RED_NOTIFICATION_MODE=none

# Comando local quando RED_NOTIFICATION_MODE=alarm.
# Exemplo Linux:
# RED_ALERT_COMMAND=paplay /usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga
# Se o caminho tiver espacos, coloque somente o caminho entre aspas:
# RED_ALERT_COMMAND=ffplay -nodisp -loop 0 "/caminho/com espacos/alarm.mp3"
# Alarmes continuos podem ser interrompidos com: ai-presence stop-alarm
RED_ALERT_COMMAND=

# Webhook externo quando RED_NOTIFICATION_MODE=phone.
# Pode apontar para Twilio, Make, Zapier, n8n ou servico proprio.
PHONE_WEBHOOK_URL=

# Observer de hooks do Codex.
# Recomendado: manter auto-start desligado e usar start/finish como marcos publicos.

# Se vazio, o worker sera derivado como:
#   <PRESENCE_COMPUTER_NAME ou hostname>:<PRESENCE_CODEX_AI_NAME>
# Exemplo: notebook-josue:codex
PRESENCE_CODEX_WORKER_ID=

PRESENCE_CODEX_AI_NAME=codex
PRESENCE_CODEX_PROTOCOL=protocol2

# Se vazio, o hook tenta usar o nome da pasta do cwd recebido do Codex.
PRESENCE_CODEX_TASK=

# Escopo do worker:
# - global: um worker por computador/IA (compatibilidade).
# - project: um worker por diretorio de projeto (recomendado).
# - session: um worker por session_id do Codex.
# - project-session: combina projeto e sessao.
PRESENCE_CODEX_WORKER_SCOPE=project

# false: o hook so atualiza worker ja ativo.
# true: qualquer evento do Codex pode criar/reativar worker automaticamente.
PRESENCE_CODEX_AUTO_START=false

# false: falhas do hook nao interrompem o fluxo do Codex.
# true: falhas do hook retornam erro para enforcement rigido.
PRESENCE_CODEX_HOOK_FAIL_CLOSED=false

# Perguntas e respostas remotas pelo Discord.
#
# Este e o bloco minimo que precisa ser preenchido para o recurso:
# - PRESENCE_REMOTE_QUESTIONS_ENABLED
# - DISCORD_QUESTION_WEBHOOK_URL
# - DISCORD_BOT_TOKEN
# - DISCORD_QUESTION_CHANNEL_ID
# - DISCORD_ALLOWED_USER_IDS
#
# Antes de ativar:
# 1. No Discord Developer Portal, habilite Message Content Intent.
# 2. Instale o bot com View Channel e Read Message History.
#    O numero minimo dessas duas permissoes e 66560.
# 3. Crie o webhook no mesmo canal indicado em DISCORD_QUESTION_CHANNEL_ID.
# 4. Inclua somente usuarios confiaveis em DISCORD_ALLOWED_USER_IDS.
#
# APPLICATION_ID, PUBLIC_KEY e BOT_PERMISSIONS_NUMBER sao dados do portal e
# nao sao lidos por este programa. Nao use BOTID: o nome correto para o token
# secreto e DISCORD_BOT_TOKEN.
#
# Mantenha false ate preencher e revisar os quatro campos seguintes.
# Depois, altere para true para ativar o recurso.
PRESENCE_REMOTE_QUESTIONS_ENABLED=false

# URL completa do webhook do canal dedicado para perguntas.
# Este valor tambem e secreto. O programa adiciona ?wait=true automaticamente.
# Exemplo de formato: https://discord.com/api/webhooks/ID/TOKEN
DISCORD_QUESTION_WEBHOOK_URL=

# Token de um bot criado no Discord Developer Portal oficial:
# https://discord.com/developers/applications
# Use um token novo obtido em Bot > Reset Token e nunca compartilhe seu valor.
DISCORD_BOT_TOKEN=

# ID numerico do mesmo canal ao qual pertence o webhook acima.
# Exemplo de formato: 123456789012345678
DISCORD_QUESTION_CHANNEL_ID=

# IDs numericos dos usuarios cujas respostas podem ser entregues ao Codex.
# Separe mais de um por virgula. Nomes de usuario nao sao aceitos.
# Exemplo de formato: 123456789012345678,987654321098765432
DISCORD_ALLOWED_USER_IDS=

# Frequencia do polling e prazo padrao de cada pergunta.
PRESENCE_QUESTION_POLL_INTERVAL_SECONDS=5
PRESENCE_QUESTION_TIMEOUT_SECONDS=1800

# Fallback de entrega por mouse e teclado.
# Mantenha false ate validar o canal, a allowlist e o titulo da janela.
PRESENCE_GUI_ANSWER_ENABLED=false

# Expressao regular compartilhada por respostas remotas e pelo comando continue.
# Ela deve identificar exatamente uma janela visivel do Codex.
# Exemplo simples: Codex
PRESENCE_CODEX_GUI_WINDOW_TITLE=

# Posicao relativa do prompt dentro da janela alvo.
PRESENCE_CODEX_GUI_CLICK_X_RATIO=0.50
PRESENCE_CODEX_GUI_CLICK_Y_RATIO=0.90

# Um hook do mesmo worker deve ocorrer dentro deste prazo para que uma entrega
# input_emitted seja marcada como delivery_confirmed.
PRESENCE_GUI_CONFIRMATION_TIMEOUT_SECONDS=120

# Automacao local de continuidade para o Codex GUI.
# O comando `ai-presence continue` usa estes valores quando os argumentos
# correspondentes nao forem informados.
# O comando exige PRESENCE_CODEX_GUI_WINDOW_TITLE ou --window-title, mas nao
# exige que PRESENCE_GUI_ANSWER_ENABLED esteja ativo.
PRESENCE_CONTINUE_MESSAGE=continue
PRESENCE_CONTINUE_DELAY_SECONDS=60

# true: depois de clique, colagem e Enter bem-sucedidos, atualiza
# last_activity_at de um worker que ja esteja active.
# false: emite a entrada sem sincronizar o monitor.
# Esta observacao nunca altera last_signal_at do Protocolo 1.
# Com escopo project, execute no projeto monitorado ou informe --project.
PRESENCE_CONTINUE_SYNC_ACTIVITY=true
